VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Only the server uses this elevated key. Never put it in a VITE_ variable or client/.env.
SUPABASE_SECRET_KEY=your-server-only-secret-key
# Server only. Use the same Gemini model for curation, transcription, and grading.
GEMINI_API_KEY=your-server-only-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_THINKING_LEVEL=medium
